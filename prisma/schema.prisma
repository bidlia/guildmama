datasource db {
  provider    = "sqlite"
  url         = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Guild {
  id                  String    @id

  users               GuildProfile[]
  roles               Role[]
}

model Role {
  id                  String    @id
  key                 String

  guildId             String
  guild               Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, key])
}

model GuildProfile {
  id                  String    @id @default(cuid())

  authority           Int       @default(1)
  
  guildId             String
  guild               Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  userId              String
  user                Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
}

model Profile {
  id                  String    @id
  createdAt           DateTime  @default(now())

  timezone            String    @default("")

  generationJoined    Int       @default(0)

  weaponsMask         Int       @default(0)
  platformsMask       Int       @default(0)
  gamesMask           Int       @default(0)

  customTitle         String    @default("Ace Hunter")
  customComment       String    @default("")
  customColour        Int       @default(0)

  accounts            InGameAccount[]
  guilds              GuildProfile[]
}

model InGameAccount {
  id                  String    @id
  name                String
  baseScore           Int       @default(0)
  expacScore          Int       @default(0)
  gameId              Int       
  platformId          Int       @default(0)

  profileId           String
  profile             Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

