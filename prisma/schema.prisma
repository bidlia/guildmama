datasource db {
  provider    = "sqlite"
  url         = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id                  String    @id // discord user id
  createdAt           DateTime  @default(now())

  timezone            String    @default("")
  customColour        Int       @default(0)

  authorityLevel      Int       @default(1)
  inGameName          String    @default("")
  customTitle         String    @default("Ace Hunter")
  customComment       String    @default("")
  generation          Int       @default(0)
  weaponBitMask       Int       @default(0)

  guildId             String 
  guild               Guild     @relation(fields: [guildId], references: [id])
}

model Guild {
  id                  String    @id // discord server id
  createdAt           DateTime  @default(now())
  
  // tracking of managed roles
  appRoles            AppRole[]
  defaultAuthority    Int       @default(1)

  members             Profile[]
}

model AppRole {
  id                  Int       @id       @default(autoincrement())
  roleId              String
  guildId             String
  guild               Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
}
